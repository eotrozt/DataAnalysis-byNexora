{
  "name": "nexora-insight",
  "productName": "Nexora Insight",
  "version": "1.1.1",
  "description": "Análise de dados com checagem de qualidade, métricas reais e insights com evidência. Funciona offline.",
  "main": "main.js",
  "author": "Nexora",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "node scripts/vendor.js && electron .",
    "dist": "node scripts/vendor.js && electron-builder --publish never",
    "dist:win": "node scripts/vendor.js && electron-builder --win --publish never",
    "dist:mac": "node scripts/vendor.js && electron-builder --mac --publish never",
    "dist:linux": "node scripts/vendor.js && electron-builder --linux --publish never",
    "test": "node --test tests/engine.test.cjs && node tests/smoke.cjs && node tests/file.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "pretest": "node scripts/vendor.js",
    "test:file": "node tests/file.cjs",
    "pretest:file": "node scripts/vendor.js"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.1.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "com.diagnosticodedados.app",
    "productName": "Nexora Insight",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
